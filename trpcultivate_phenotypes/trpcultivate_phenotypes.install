<?php

/**
 * @file
 * Defines hooks required during install of Tripal Cultivate Phenotypes.
 */

use Drupal\Core\File\FileSystemInterface;

/**
 * Implements hook_install().
 *
 * When the module is installed, we use the configuration values to setup
 * the site for this module. Specifically,
 *  - create file directories.
 *  - register tripaljobs to insert the cvterms we use as defaults for
 *    our term configuration. The callback for this job is in the .module file.
 *
 * @see config/install
 * @see config/schema
 * @see trpcultivate_phenotypes.module
 */
function trpcultivate_phenotypes_install() {
  // Setup file system/directories used to store files generated by and file
  // submitted to Tripal Cultivate Phenotyopes modules suite.
  $file_system = \Drupal::service('file_system');

  $dirs = \Drupal::config('trpcultivate_phenotypes.settings')
    ->get('trpcultivate.phenotypes.directory');

  foreach ($dirs as $dir) {
    if (!empty($dir)) {
      // Setup directory when configuration entry is set to
      // a directory, skip the blank/empty values.
      $file_system->prepareDirectory($dir, FileSystemInterface::CREATE_DIRECTORY);
    }
  }

  // Register a Tripal Job instance to install default terms and
  // set term configuration variable.
  $user = \Drupal::currentUser();

  try {
    tripal_add_job(
      'Tripal Cultivate Phenotypes: Install Ontology and Terms',
      'tripal',
      'trpcultivate_phenotypes_install_ontologyterms',
      [],
      $user->id(),
      10,
      []
    );
  }
  catch (\Exception $e) {
    throw new \Exception('Cannot create a job to install terms:' . $e->getMessage);
  }
}

/**
 * Implements hook_schema().
 */
function trpcultivate_phenotypes_schema() {

  $schema = [
    'trpcultivate_phenocombo' => [
      'description' => 'Keeps track of traits-combo (measurements) a research experiment intends to take.',
      'fields' => [
        'combo_id' => [
          'description' => 'The primary identifier of a trait combo.',
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'project_id' => [
          'description' => 'Links to the research experiment this combo is specific to.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'attr_id' => [
          'description' => 'The trait being measured (i.e. Canopy Height).',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'observable_id' => [
          'description' => 'The method used (i.e. used measuring stick from the ground to the highest greenery without touching the plant).',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'unit_id' => [
          'description' => 'The unit used (i.e. cm or inches).',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'uid' => [
          'description' => 'The Drupal user who configured this combo (user.uid).',
          'type' => 'int',
          'not null' => TRUE,
        ],
        'label' => [
          'description' => 'Experiment-specific column header.',
          'type' => 'varchar',
          'not null' => TRUE,
        ],
        'is_archived' => [
          'description' => 'True if a combo has been archived and describes a previous state of configuration.',
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'is_required' => [
          'description' => 'True if a combo must exists in the data file and must have a value.',
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'was_collected' => [
          'description' => 'Indicates that a combo was used in the run of the COLLECT Importer.',
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'was_shared' => [
          'description' => 'Indicates that a combo was used in the run of the SHARE Importer.',
          'type' => 'int',
          'not null' => TRUE,
          'default' => 0,
        ],
        'timestamp' => [
          'description' => 'The datetime that this combo was configured.',
          'type' => 'int',
          'not null' => TRUE,
        ],
      ],
      'primary key' => ['combo_id'],
      'foreign keys' => [
        'project_id' => [
          'table' => 'project',
          'columns' => [
            'project_id' => 'project_id',
          ],
        ],
        'attr_id' => [
          'table' => 'cvterm',
          'columns' => [
            'attr_id' => 'cvterm_id',
          ],
        ],
        'observable_id' => [
          'table' => 'cvterm',
          'columns' => [
            'observable_id' => 'cvterm_id',
          ],
        ],
        'unit_id' => [
          'table' => 'cvterm',
          'columns' => [
            'unit_id' => 'cvterm_id',
          ],
        ],
        'uid' => [
          'table' => 'users',
          'columns' => [
            'uid' => 'uid',
          ],
        ],
      ],
      'unique_keys' => [
        'composite_key' => [
          'project_id',
          'attr_id',
          'observable_id',
          'unit_id',
        ],
      ],
    ],
  ];

  return $schema;
}
