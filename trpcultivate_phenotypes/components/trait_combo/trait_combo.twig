<div {{ attributes.addClass('tcp-trait-combo') }}>

	<def>
		{{ name }}

    {% if status %}

		  {% set status_fa_map = {
				'archived': 'fa-box-archive',
				'required': 'fa-star',
				'shared': 'fa-hand-holding-heart',
				'collected': 'fa-ruler'
			} %}

      {% for status_item, status_value in status %}
        {% if status_value == 1 %}
					<i {{ attributes.setAttribute('class', 'tcp-pheno-' ~ status_item ~ ' fa-solid ' ~ status_fa_map[status_item]) }}></i>
        {% endif %}
   		{% endfor %}
    {% endif %}
	</def>

	<em>{{ definition }}</em>

    {{ multiselect_method ? '<div>' : '' }}
		  {% for method in method_unit_combo %}
			  <def>{{ method['method_shortname'] }}: ({{ method['unit'] }})
				  <small>{{ method  ['type'] }}</small>
			  </def>
			  {{ method['collection_method'] }}

				{% if multiselect_method %}
           {{ field_label }} {{ add }}
				{% endif %}

		  {% endfor %}
    {{ multiselect_method ? '</div>' : '' }}

</div>
