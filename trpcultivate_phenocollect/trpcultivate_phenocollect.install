<?php

/**
 * @file
 * Defines hooks during install of Tripal Cultivate Phenotypes - Collect.
 */

/**
 * Implements hook_update_N().
 *
 * Create storage for unpublished (raw) phenotypes by mirroring Chado tables
 * phenotype and phenotypeprop into Drupal database schema (public).
 */
function trpcultivate_phenocollect_update_10001() {

  $base_table = 'phenotype';
  $prop_table = $base_table . 'prop';

  $chado_schema = \Drupal::service('tripal_chado.database')
    ->schema();

  if ($chado_schema->tableExists($base_table) && $chado_schema->tableExists($prop_table)) {
    // Source tables required for replication exist.
    $drupaldb_connection = \Drupal::service('database');
    $drupaldb_schema = $drupaldb_connection->schema();

    // Ensure that tables are not already present in Drupal database schema.
    if ($drupaldb_schema->tableExists($base_table) && $drupaldb_schema->tableExists($prop_table)) {
      return;
    }

    // Mirror Chado phenotype and phenotypeprop tables into Drupal database.
    $drupaldb_schema_name = $drupaldb_connection
      ->query('SELECT current_schema()')
      ->fetchField();

    $chado_schema_name = $chado_schema->getSchemaName();
    $tripal_logger = \Drupal::service('tripal.logger');

    foreach ([$base_table, $prop_table] as $table) {
      $drupaldb_connection
        ->query("CREATE TABLE IF NOT EXISTS $drupaldb_schema_name.$table
                 (LIKE $chado_schema_name.$table INCLUDING ALL)");

      $tripal_logger
        ->notice('The relation ' . $table . ' has been created in schema ' . $drupaldb_schema_name);
    }
  }
}
